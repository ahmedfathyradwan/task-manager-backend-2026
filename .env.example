# Copy this file to .env and fill in real values. Never commit .env.
PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/task_manager
# Must be at least 32 random characters, e.g.:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
ADMIN_NAME=أحمد
ADMIN_PHONE=01000000000
ADMIN_PASSWORD=0000
NODE_ENV=production
# Optional: extra allowed frontend origins, comma-separated.
# CLIENT_ORIGINS=https://your-app.vercel.app