# Copy this file to .env and fill in real values. Never commit .env.
PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/task_manager
# Must be at least 32 random characters, e.g.:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
NODE_ENV=production
# Optional: set these three values together to provision the administrator.
# The password must be exactly four digits.
# ADMIN_NAME=
# ADMIN_PHONE=
# ADMIN_PASSWORD=
# Optional: comma-separated frontend origins. When set, this replaces the defaults.
# CLIENT_ORIGINS=https://your-app.vercel.app